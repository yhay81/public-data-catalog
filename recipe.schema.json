{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yhay81/public-data-catalog/main/recipe.schema.json",
  "title": "Verified Public Data Retrieval Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "title",
    "question",
    "source_id",
    "request",
    "expect",
    "result",
    "interpretation",
    "attribution",
    "last_verified"
  ],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "title": {"$ref": "#/$defs/localized"},
    "question": {"$ref": "#/$defs/localized"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "allowed_hosts"],
      "properties": {
        "method": {"const": "GET"},
        "url": {"type": "string", "format": "uri"},
        "allowed_hosts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "headers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Accept": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "content_type_contains", "max_bytes", "assertions"],
      "properties": {
        "status": {"const": 200},
        "content_type_contains": {"type": "string", "minLength": 1},
        "max_bytes": {"type": "integer", "minimum": 1024, "maximum": 1000000},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointer"],
            "properties": {
              "pointer": {"type": "string"},
              "equals": {},
              "minimum": {"type": "number"},
              "min_length": {"type": "integer", "minimum": 0}
            },
            "oneOf": [
              {"required": ["equals"]},
              {"required": ["minimum"]},
              {"required": ["min_length"]}
            ]
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/resultField"}
        }
      }
    },
    "interpretation": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_url", "license_url", "credit"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "license_url": {"type": "string", "format": "uri"},
        "credit": {"type": "string", "minLength": 1}
      }
    },
    "last_verified": {"type": "string", "format": "date"}
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja", "en"],
      "properties": {
        "ja": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1}
      }
    },
    "resultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "pointer"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "label": {"$ref": "#/$defs/localized"},
        "pointer": {"type": "string"},
        "unit": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "transform": {
          "type": "string",
          "enum": ["integer", "number", "string", "unix_milliseconds_to_iso8601"]
        }
      }
    }
  }
}
