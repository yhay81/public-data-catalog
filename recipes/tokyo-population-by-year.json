{
  "$schema": "../recipe.schema.json",
  "id": "tokyo-population-by-year",
  "contract_version": "1.0.0",
  "title": {
    "ja": "東京都の年次総人口",
    "en": "Tokyo annual total population"
  },
  "question": {
    "ja": "指定した年の東京都の総人口は何人か。",
    "en": "What was Tokyo's total population in the requested year?"
  },
  "source_id": "statistics-dashboard-api",
  "parameters": {
    "year": {
      "type": "integer",
      "description": {
        "ja": "取得する暦年（検証済み範囲：2015年から2025年）",
        "en": "Calendar year to retrieve (verified range: 2015 through 2025)"
      },
      "default": 2023,
      "minimum": 2015,
      "maximum": 2025
    }
  },
  "request": {
    "method": "GET",
    "url": "https://dashboard.e-stat.go.jp/api/1.0/Json/getData?Lang=JP&IndicatorCode=0201010000000010000&RegionCode=13000&Time=2023CY00&Cycle=3&IsSeasonalAdjustment=1&MetaGetFlg=Y&SectionHeaderFlg=1",
    "allowed_hosts": ["dashboard.e-stat.go.jp"],
    "headers": {
      "Accept": "application/json"
    },
    "bindings": [
      {
        "parameter": "year",
        "location": "query",
        "name": "Time",
        "format": "{value}CY00"
      }
    ]
  },
  "expect": {
    "status": 200,
    "content_type_contains": "application/json",
    "max_bytes": 100000,
    "assertions": [
      {
        "pointer": "/GET_STATS/RESULT/status",
        "equals": "0"
      },
      {
        "pointer": "/GET_STATS/STATISTICAL_DATA/RESULT_INF/TOTAL_NUMBER",
        "equals": "1"
      },
      {
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ",
        "min_length": 1
      }
    ]
  },
  "result": {
    "fields": [
      {
        "name": "population",
        "label": {
          "ja": "総人口",
          "en": "Total population"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/$",
        "unit": "人",
        "transform": "integer"
      },
      {
        "name": "region-code",
        "label": {
          "ja": "地域コード",
          "en": "Region code"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/@regionCode"
      },
      {
        "name": "time-code",
        "label": {
          "ja": "時間コード",
          "en": "Time code"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/@time"
      },
      {
        "name": "provisional-code",
        "label": {
          "ja": "速報・確報コード",
          "en": "Provisional/final code"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/@isProvisional",
        "description": "0は確報、1は速報を表します。"
      }
    ]
  },
  "interpretation": [
    "総人口は日本人・外国人の別不詳および年齢不詳を含みます。",
    "人口推計は国勢調査人口を基準に、その後の人口動向から算出されます。",
    "地域コード13000は東京都です。時間コードと速報・確報コードを結果と一緒に確認してください。"
  ],
  "attribution": {
    "source_url": "https://dashboard.e-stat.go.jp/static/api?language=ja",
    "license_url": "https://dashboard.e-stat.go.jp/static/terms",
    "credit": "出典：統計ダッシュボード（https://dashboard.e-stat.go.jp/）"
  },
  "last_verified": "2026-07-24"
}
