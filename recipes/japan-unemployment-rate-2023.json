{
  "$schema": "../recipe.schema.json",
  "id": "japan-unemployment-rate-2023",
  "title": {
    "ja": "2023年の日本の完全失業率",
    "en": "Japan unemployment rate in 2023"
  },
  "question": {
    "ja": "2023年の日本の完全失業率（男女計）は何パーセントか。",
    "en": "What was Japan's unemployment rate for both sexes in 2023?"
  },
  "source_id": "statistics-dashboard-api",
  "request": {
    "method": "GET",
    "url": "https://dashboard.e-stat.go.jp/api/1.0/Json/getData?Lang=JP&IndicatorCode=0301010000020020010&RegionCode=00000&Time=2023CY00&Cycle=3&IsSeasonalAdjustment=1&MetaGetFlg=Y&SectionHeaderFlg=1",
    "allowed_hosts": ["dashboard.e-stat.go.jp"],
    "headers": {
      "Accept": "application/json"
    }
  },
  "expect": {
    "status": 200,
    "content_type_contains": "application/json",
    "max_bytes": 100000,
    "assertions": [
      {
        "pointer": "/GET_STATS/RESULT/status",
        "equals": "0"
      },
      {
        "pointer": "/GET_STATS/STATISTICAL_DATA/RESULT_INF/TOTAL_NUMBER",
        "equals": "1"
      },
      {
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ",
        "min_length": 1
      }
    ]
  },
  "result": {
    "fields": [
      {
        "name": "unemployment-rate",
        "label": {
          "ja": "完全失業率（男女計）",
          "en": "Unemployment rate, both sexes"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/$",
        "unit": "%",
        "transform": "number"
      },
      {
        "name": "survey-code",
        "label": {
          "ja": "統計調査コード",
          "en": "Statistical survey code"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/@stat"
      },
      {
        "name": "time-code",
        "label": {
          "ja": "時間コード",
          "en": "Time code"
        },
        "pointer": "/GET_STATS/STATISTICAL_DATA/DATA_INF/DATA_OBJ/0/VALUE/@time"
      }
    ]
  },
  "interpretation": [
    "完全失業率は、労働力人口に占める完全失業者の割合です。",
    "このレシピは年次の原数値を取得し、季節調整済み月次値とは区別します。",
    "人口ベンチマークの切替えに伴う時系列上の変動があり得ます。"
  ],
  "attribution": {
    "source_url": "https://dashboard.e-stat.go.jp/static/api?language=ja",
    "license_url": "https://dashboard.e-stat.go.jp/static/terms",
    "credit": "出典：統計ダッシュボード（https://dashboard.e-stat.go.jp/）"
  },
  "last_verified": "2026-07-24"
}
