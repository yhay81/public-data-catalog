{
  "name": "public-data-catalog",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Plain-language search for Japanese public datasets and official statistics.",
  "scripts": {
    "artifacts": "python3 scripts/build_artifacts.py",
    "artifacts:check": "python3 scripts/build_artifacts.py --check",
    "mcp": "tsx src/stdio.ts",
    "test": "node --import tsx --test tests/mcp/*.test.ts",
    "typecheck": "tsc --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "agents": "0.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
